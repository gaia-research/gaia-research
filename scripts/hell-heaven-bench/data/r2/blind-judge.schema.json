{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hh-r2-blind-judge/v1",
  "title": "R2 blinded pairwise judgment companion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assignmentId", "taskId", "rubricVersion", "candidateAArtifactSha256", "candidateBArtifactSha256", "verdict", "scores", "rationale", "judgeIdPseudonym"],
  "properties": {
    "schema": { "const": "hh-r2-blind-judge/v1" },
    "assignmentId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "rubricVersion": { "type": "string", "minLength": 1 },
    "candidateAArtifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateBArtifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verdict": { "enum": ["A", "B", "tie", "invalid"] },
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 5 }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "judgeIdPseudonym": { "type": "string", "minLength": 1 }
  }
}
